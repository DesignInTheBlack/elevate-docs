---
/* Page title with the page's description set beneath it as a subhead. */
const { title, description } = Astro.props.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="page-lead">{description}</p>}

<style>
	h1 {
		margin-top: var(--s-4);
		font-size: var(--t-title);
		font-weight: 640;
		font-stretch: 92%;
		letter-spacing: -0.035em;
		line-height: var(--lh-tight);
		color: var(--ink);
	}
	.page-lead {
		margin-top: var(--s-3);
		max-width: 34ch;
		font-size: var(--t-lead);
		font-weight: 500;
		font-stretch: 94%;
		line-height: var(--lh-snug);
		letter-spacing: -0.02em;
		color: var(--slate);
		text-wrap: balance;
	}
</style>
