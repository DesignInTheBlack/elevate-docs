---
/* Page title with the page's description set beneath it as a subhead. */
const { title, description } = Astro.props.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="page-lead">{description}</p>}

<style>
	h1 {
		margin-top: 1rem;
		font-size: clamp(2.5rem, 2rem + 2.4vw, 3.5rem);
		font-weight: 640;
		font-stretch: 92%;
		letter-spacing: -0.035em;
		line-height: 1.05;
		color: var(--ink);
	}
	.page-lead {
		margin-top: 1rem;
		max-width: 34ch;
		font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem);
		font-weight: 500;
		font-stretch: 94%;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--slate);
		text-wrap: balance;
	}
</style>
