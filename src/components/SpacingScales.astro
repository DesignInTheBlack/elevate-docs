---
/*
  view="map": all three scales on one logarithmic ruler, 1px to 1920px, so it's
  clear they form one continuous range.
  view="d" | "c" | "s": one scale as a compact spec grid, each token with a bar
  drawn to scale (the detail scale at real size).
  Values come from the same design tokens the compiler reads.
*/
import { spacing } from '../../elevate/core/system/design/spacing.ts';

interface Props {
	view: 'map' | 'd' | 'c' | 's';
}
const { view } = Astro.props;

const all = Object.entries(spacing).map(([k, v]) => {
	const s = String(v);
	const px = s.endsWith('rem') ? parseFloat(s) * 16 : parseFloat(s);
	return { k, v: s, px, scale: k === 'px' ? 'px' : k[0] };
});
const SCALES = {
	d: { name: 'Detail', note: 'inside components' },
	c: { name: 'Content', note: 'between blocks and sections' },
	s: { name: 'Space', note: 'widths and page structure' },
} as const;

// Log position, 1px at 0% and 1920px at 100%
const MAX = 1920;
const pos = (px: number) => (Math.log(px) / Math.log(MAX)) * 100;
const bands = (['d', 'c', 's'] as const).map((s) => {
	const items = all.filter((t) => t.scale === s);
	const lo = items[0].px;
	const hi = items[items.length - 1].px;
	return { s, ...SCALES[s], lo, hi, a: pos(lo), b: pos(hi), items };
});
const marks = [
	{ px: 44, label: 'tap target', k: 'd11' },
	{ px: 320, label: 'small phone', k: 'c13' },
	{ px: 1440, label: 'laptop', k: 's12' },
];

const items = view === 'map' ? [] : all.filter((t) => t.scale === view || (view === 'd' && t.scale === 'px'));
const top = items.length ? items[items.length - 1].px : 1;
---
{view === 'map' ? (
	<figure class="smap" data-pagefind-ignore>
		<div class="bands">
			{bands.map((b) => (
				<div class={`band band-${b.s}`} style={`left:${b.a}%;width:${b.b - b.a}%`}>
					<span class="band-name"><code>{b.s}</code> {b.name}</span>
					<span class="band-range">{b.lo}–{b.hi}px</span>
				</div>
			))}
		</div>
		<div class="track">
			{bands.flatMap((b) => b.items.map((t) => (
				<i class={`tick tick-${b.s}`} style={`left:${pos(t.px)}%`} title={`${t.k}: ${t.v} (${t.px}px)`}></i>
			)))}
			{bands.map((b) => <span class={`rail rail-${b.s}`} style={`left:${b.a}%;width:${b.b - b.a}%`}></span>)}
		</div>
		<div class="marks">
			{marks.map((m, n) => (
				<span class={`mark mark-${n}`} style={`left:${pos(m.px)}%`}>
					<b>{m.px}px</b><code>{m.k}</code><br />{m.label}
				</span>
			))}
		</div>
		<figcaption>One ruler, 1px to 1920px, on a log scale. Each tick is a token.</figcaption>
	</figure>
) : (
	<div class={`sgrid sgrid-${view}`} data-pagefind-ignore>
		{items.map((t) => (
			<div class="cell">
				<code class="k">{t.k}</code>
				<span class="v">{t.v}<em>{t.v.endsWith('px') ? 'hairline' : `${t.px}px`}</em></span>
				<i class="bar" style={view === 'd' ? `width:${Math.max(t.px, 1)}px` : `width:${(t.px / top) * 100}%`}></i>
			</div>
		))}
	</div>
)}

<style>
	.smap,
	.sgrid {
		--c-d: var(--g-prop);
		--c-c: var(--g-mod);
		--c-s: var(--g-state);
	}
	.smap :global(*),
	.sgrid :global(*) {
		margin-top: 0 !important;
	}

	/* ---------- Map ---------- */
	.smap {
		display: grid;
		gap: var(--s-3);
		padding: var(--s-6) var(--s-6) var(--s-5);
		border-radius: var(--r-l);
		background: var(--mist);
	}
	.bands,
	.track,
	.marks {
		position: relative;
	}
	.bands {
		height: 2.75rem;
	}
	.band {
		position: absolute;
		bottom: 0;
		display: grid;
		gap: 0.25rem;
		white-space: nowrap;
	}
	.band-name {
		font-size: var(--t-s);
		font-weight: 620;
		color: var(--ink);
	}
	.band-name code {
		background: none;
		padding: 0;
		font-weight: 600;
	}
	.band-d .band-name code { color: var(--c-d); }
	.band-c .band-name code { color: var(--c-c); }
	.band-s .band-name code { color: var(--c-s); }
	.band-range {
		font: 500 var(--t-xs)/1 var(--sl-font-mono);
		color: var(--slate);
	}
	.track {
		height: 1.75rem;
	}
	.tick {
		position: absolute;
		top: 0;
		width: 1.5px;
		height: 1rem;
		margin-left: -0.75px;
		border-radius: 1px;
	}
	.tick-d { background: var(--c-d); }
	.tick-c { background: var(--c-c); }
	.tick-s { background: var(--c-s); }
	.rail {
		position: absolute;
		top: 1.25rem;
		height: 0.375rem;
		border-radius: 1rem;
	}
	.rail-d { background: var(--c-d); }
	.rail-c { background: var(--c-c); }
	.rail-s { background: var(--c-s); }
	.marks {
		height: 3.25rem;
		border-top: 1px dashed rgb(29 29 31 / 0.18);
		padding-top: var(--s-2);
	}
	.mark {
		position: absolute;
		top: var(--s-3);
		transform: translateX(-50%);
		display: block;
		font-size: var(--t-xs);
		line-height: 1.35;
		color: var(--slate);
		white-space: nowrap;
	}
	.mark::before {
		content: '';
		position: absolute;
		left: 50%;
		top: calc(var(--s-3) * -1 - 1px);
		height: var(--s-2);
		border-left: 1px solid rgb(29 29 31 / 0.35);
	}
	.mark b {
		color: var(--ink);
		font-weight: 600;
	}
	.mark code {
		margin-left: 0.375em;
		background: none;
		padding: 0;
		font-size: inherit;
		color: var(--slate);
	}
	/* the last landmark hangs left of its tick so it stays inside the panel */
	.mark-2 {
		transform: translateX(calc(-100% + 0.5rem));
		text-align: right;
	}
	.mark-2::before {
		left: auto;
		right: 0.5rem;
	}
	.smap figcaption {
		font-size: var(--t-xs);
		color: var(--slate);
	}

	/* ---------- Grids ---------- */
	.sgrid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
		gap: var(--s-2);
	}
	.cell {
		display: grid;
		align-content: start;
		gap: var(--s-1);
		padding: var(--s-3) var(--s-4) var(--s-4);
		border-radius: var(--r-s);
		background: var(--mist);
	}
	.k {
		background: none !important;
		padding: 0 !important;
		font: 500 var(--t-l) / 1.1 var(--sl-font-mono) !important;
		letter-spacing: -0.03em;
	}
	.sgrid-d .k { color: var(--c-d); }
	.sgrid-c .k { color: var(--c-c); }
	.sgrid-s .k { color: var(--c-s); }
	.v {
		display: flex;
		justify-content: space-between;
		gap: var(--s-2);
		font: 500 var(--t-xs) / 1.4 var(--sl-font-mono);
		color: var(--ink);
	}
	.v em {
		font-style: normal;
		color: var(--slate);
	}
	.bar {
		display: block;
		height: 0.375rem;
		margin-top: var(--s-2) !important;
		border-radius: 1px;
		min-width: 1px;
	}
	.sgrid-d .bar { background: var(--c-d); }
	.sgrid-c .bar { background: var(--c-c); }
	.sgrid-s .bar { background: var(--c-s); }

	@media (max-width: 40rem) {
		.smap {
			padding: var(--s-5) var(--s-4) var(--s-4);
		}
		.band-name {
			font-size: var(--t-xs);
		}
		.band-range {
			font-size: 0.625rem;
		}
		.mark-1 {
			display: none;
		}
		.sgrid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.cell {
			padding: var(--s-3);
		}
		.k {
			font-size: var(--t-m) !important;
		}
		.v {
			flex-direction: column;
			gap: 0;
		}
	}
</style>
