---
/*
  Home page body. Kept in a component (not MDX) so the docs site's own Elevate
  compiler, which scans MDX for class attributes, doesn't treat these layout
  classes as Elevate tokens.

  Each section has its own composition so the page has a rhythm, not a column:
  split, editorial header, a spec row, and a dark closing panel.
*/
import { Code } from '@astrojs/starlight/components';
import FlexLab from './FlexLab.astro';
import TokenMap from './TokenMap.astro';
---
<div class="home">

<section class="home-section home-split">
	<div class="home-head">
		<p class="home-eyebrow">Tokens</p>
		<h2>Write what you mean.</h2>
		<p class="home-sub">Every class names a token from your design system. Elevate looks up the value and writes exactly that CSS. Change the token, and every class that uses it follows.</p>
		<a class="home-more" href="/reference/system-token-types/">How tokens work</a>
	</div>
	<TokenMap />
</section>

<section class="home-section">
	<div class="home-head home-head-wide">
		<div>
			<p class="home-eyebrow">Layout</p>
			<h2>A whole layout, in one class.</h2>
		</div>
		<p class="home-sub">Direction and alignment in a single class, on axes you can see. Click any part of it.</p>
	</div>
	<FlexLab />
</section>

<section class="home-section">
	<div class="home-head home-head-center">
		<p class="home-eyebrow">Structure</p>
		<h2>Everything else stays in your HTML.</h2>
		<p class="home-sub">The things that usually send you back to a stylesheet have a place in the class list.</p>
	</div>

	<div class="home-specs">
		<a href="/guides/4-env-aliases/">
			<code><span class="el-prop">env</span><span class="el-sep">:</span><span class="el-mod">card</span></code>
			<h3>Envelopes</h3>
			<p>Name a list of classes once, reuse it anywhere, and reopen it with <code>env:card:open</code> to edit.</p>
		</a>
		<a href="/guides/3-specificity/">
			<code><span class="el-prop">ctx</span><span class="el-sep">:</span><span class="el-mod">card</span></code>
			<h3>Context scopes</h3>
			<p>Draw a boundary and end it with <code>ctx:end:card</code>. Styles inside can't leak out.</p>
		</a>
		<a href="/reference/supported-selectors/">
			<code><span class="el-state">@child</span></code>
			<h3>Relational selectors</h3>
			<p>Style children, descendants, siblings or the parent from inside a scope.</p>
		</a>
		<a href="/reference/supported-selectors/">
			<code><span class="el-state">@hover</span><span class="el-sep">:[</span><span class="el-mod">…</span><span class="el-sep">]</span></code>
			<h3>Grouped states</h3>
			<p>Change several things on hover, focus or any other state, in one group.</p>
		</a>
	</div>
</section>

<section class="home-section">
	<div class="home-panel">
		<p class="home-eyebrow">Output</p>
		<h2>Ship only what you use.</h2>
		<p class="home-sub">Nothing is prebuilt. Elevate watches your files and compiles CSS for the classes you actually write, mobile-first, with errors that point to the exact file and line.</p>

		<Code lang="bash" title="Start in three commands" code={`npm install elevate-framework
npx elevate-framework prepare
npm run elevate`} />

		<div class="home-actions">
			<a class="home-primary" href="/guides/2-getting-started/">Read the guide</a>
			<a class="home-quiet" href="/playground/">Open the playground</a>
		</div>
	</div>

	<blockquote class="home-quote">
		<p>“When I am working on a problem, I never think about beauty, but when I have finished, if the solution is not beautiful, I know it is wrong.”</p>
		<cite>R. Buckminster Fuller</cite>
	</blockquote>
</section>

</div>
